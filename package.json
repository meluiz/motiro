{
  "$schema": "https://json.schemastore.org/package.json",
  "type": "module",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "name": "@motiro/monorepo",
  "description": "Explore a versatile assortment of helper utility functions",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "https://github.com/meluiz/motiro"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "clean": "bun run --filter '*' clean",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "typecheck": "tsc --noEmit",
    "preflight": "bun run lint && bun run typecheck",
    "prepare": "lefthook install",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "workspaces": {
    "packages": ["packages/*"],
    "catalog": {
      "@biomejs/biome": "^2.5.5",
      "tsdown": "^0.22.14",
      "typescript": "^7.0.2"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "lefthook": "^2.1.10",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "resolutions": {
    "@motiro/core": "workspace:*",
    "@motiro/types": "workspace:*",
    "@motiro/guard": "workspace:*",
    "@motiro/string": "workspace:*",
    "@motiro/number": "workspace:*",
    "@motiro/collection": "workspace:*"
  }
}
