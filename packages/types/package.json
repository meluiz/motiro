{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "name": "@motiro/types",
  "description": "Shared TypeScript utility types for the Motiro toolkit — type-level helpers with zero runtime footprint.",
  "packageManager": "bun@1.4.0",
  "author": {
    "name": "meluiz",
    "url": "https://meluiz.com"
  },
  "homepage": "https://github.com/meluiz/motiro",
  "repository": {
    "type": "git",
    "directory": "packages/types",
    "url": "git+https://github.com/meluiz/motiro.git"
  },
  "bugs": {
    "url": "https://github.com/meluiz/motiro/issues"
  },
  "keywords": [
    "types",
    "helper",
    "motiro",
    "utility",
    "toolkit",
    "typescript",
    "type-utils",
    "type-level",
    "utility-types"
  ],
  "types": "./dist/index.d.mts",
  "files": ["dist", "README.md", "package.json"],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts"
    },
    "./*": {
      "types": "./dist/*.d.mts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@biomejs/biome": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
