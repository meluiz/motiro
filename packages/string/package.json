{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "name": "@motiro/string",
  "description": "Fast, tree-shakeable string helpers — case conversion, trimming, padding, slugify, templating and more. Part of the Motiro utility toolkit.",
  "packageManager": "bun@1.3.14",
  "author": {
    "name": "meluiz",
    "url": "https://meluiz.com"
  },
  "homepage": "https://github.com/meluiz/motiro",
  "repository": {
    "type": "git",
    "directory": "packages/string",
    "url": "git+https://github.com/meluiz/motiro.git"
  },
  "bugs": {
    "url": "https://github.com/meluiz/motiro/issues"
  },
  "keywords": [
    "pad",
    "trim",
    "helper",
    "motiro",
    "string",
    "slugify",
    "utility",
    "toolkit",
    "template",
    "typescript",
    "string-utils",
    "tree-shakeable",
    "case-conversion",
    "string-manipulation"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "package.json"],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
