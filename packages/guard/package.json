{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "name": "@motiro/guard",
  "description": "Composable TypeScript type guards and runtime validation for the Motiro toolkit — small, well-typed predicates you can compose.",
  "packageManager": "bun@1.3.14",
  "author": {
    "name": "meluiz",
    "url": "https://meluiz.com"
  },
  "homepage": "https://github.com/meluiz/motiro",
  "repository": {
    "type": "git",
    "directory": "packages/guard",
    "url": "git+https://github.com/meluiz/motiro.git"
  },
  "bugs": {
    "url": "https://github.com/meluiz/motiro/issues"
  },
  "keywords": [
    "guard",
    "guards",
    "motiro",
    "toolkit",
    "predicate",
    "validation",
    "typescript",
    "type-guard",
    "type-guards",
    "runtime-validation"
  ],
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": ["dist", "README.md"],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@biomejs/biome": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
